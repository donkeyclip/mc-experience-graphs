{
  "name": "@donkeyclip/mc-experience-graphs",
  "version": "1.0.0",
  "description": "MotorCortex plugin for chart animations using ECharts",
  "main": "dist/bundle.cjs.js",
  "module": "dist/bundle.esm.js",
  "browser": "dist/bundle.umd.js",
  "type": "module",
  "author": "Donkeyclip",
  "repository": {
    "type": "git",
    "url": "https://github.com/donkeyclip/mc-experience-graphs.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:lib && npm run build:demo",
    "build:lib": "rollup -c",
    "start": "npm run build:lib && concurrently -c \"cyan.bold,magenta.bold\" \"npm:build:lib -- -w\" \"npm:start:demo\"",
    "start:demo": "webpack serve --mode=development --config ./demo/webpack.config.cjs",
    "build:demo": "webpack --mode=production --config ./demo/webpack.config.cjs"
  },
  "keywords": [
    "motorcortex",
    "echarts",
    "charts",
    "graphs"
  ],
  "peerDependencies": {
    "@donkeyclip/motorcortex": ">=9.24.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.27.2",
    "@babel/core": "^7.27.4",
    "@babel/preset-env": "^7.29.2",
    "@donkeyclip/motorcortex": "^9.24.0",
    "@donkeyclip/motorcortex-player": "2.15.18",
    "@rollup/plugin-babel": "^7.0.0",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-terser": "^1.0.0",
    "babel-loader": "^10.1.1",
    "concurrently": "^9.1.2",
    "css-loader": "7.1.4",
    "rimraf": "6.1.3",
    "rollup": "^4.60.0",
    "style-loader": "^4.0.0",
    "webpack": "^5.99.9",
    "webpack-cli": "^7.0.2",
    "webpack-dev-server": "5.2.6"
  },
  "dependencies": {
    "echarts": "^5.6.0"
  }
}
